#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SOURCE_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE")"
  case "$LINK_TARGET" in
    /*) SOURCE="$LINK_TARGET" ;;
    *) SOURCE="$SOURCE_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
SKILL_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
DEFAULT_BOOT_TIMEOUT="${MADW_BOOT_TIMEOUT:-15}"
DEFAULT_TUI_READY_TIMEOUT="${MADW_TUI_TIMEOUT:-10}"
DEFAULT_WAIT_TIMEOUT="${MADW_WAIT_TIMEOUT:-3600}"

usage() {
  cat <<'EOF'
Usage:
  madw start [pi|codex] [--layout balanced|columns] [--sessions] [--boot-timeout SECONDS]
  madw bootstrap leader
  madw launch <pi|codex>   # run inside a role pane
  madw status
  madw logs <leader|impl|review> [lines]
  madw debug <on|off>
  madw watch
  madw attach [leader|impl|review]
  madw send <leader|impl|review> <message>
  madw wait <impl|review> <TASK-ID> <ROUND> [timeout-seconds]
  madw signal <impl|review> <TASK-ID> <ROUND>
  madw restart <leader|impl|review>
  madw stop
  madw doctor [pi|codex]
  madw id

Defaults:
  - Project-scoped tmux session: madw-<repo>-<path-hash>
  - Three side-by-side role panes by default: Lead / Impl / Review
  - --sessions keeps three separate role sessions instead
  - Explicit pi/codex or MADW_AGENT_CMD uses the legacy three-pane auto-start
  - Layout: MADW_LAYOUT or columns (Lead / Impl / Review side by side)
  - Runtime: manual by default; MADW_RUNTIME selects an auto-start runtime

Environment:
  MADW_AGENT_CMD       Override the interactive Agent command.
  MADW_RUNTIME         Auto-start runtime: pi or codex (omitted: manual mode).
  MADW_CODEX_NETWORK_ACCESS=0|1  Codex workspace-write network policy (default: 1).
                                 1 also allows outbound network access; 0 is restrictive.
  MADW_SESSION         Override the project-scoped tmux session name.
  MADW_BOOT_TIMEOUT    Agent process startup timeout (default: 15).
  MADW_TUI_TIMEOUT     Agent UI readiness timeout (default: 10). Handoffs fail
                       if a pi/codex pane does not enter its UI.
  MADW_TUI_READY=1     Also gate custom MADW_AGENT_CMD agents on UI readiness
                       (for agents that draw a full-screen alternate-screen UI).
  MADW_WAIT_TIMEOUT    Handoff completion timeout (default: 3600).
  MADW_NO_ATTACH=1     Do not attach after start.
EOF
}

die() {
  echo "madw: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

project_root() {
  if [ -n "${MADW_PROJECT_ROOT:-}" ]; then
    (cd "$MADW_PROJECT_ROOT" && git rev-parse --show-toplevel 2>/dev/null) ||
      die "MADW_PROJECT_ROOT is not inside a Git repository: $MADW_PROJECT_ROOT"
    return
  fi
  git rev-parse --show-toplevel 2>/dev/null ||
    die "run madw inside a Git repository"
}

project_slug() {
  local root base slug
  root="$(project_root)"
  base="$(basename "$root")"
  slug="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_.-]+/-/g; s/^-+//; s/-+$//')"
  [ -n "$slug" ] || slug="project"
  printf '%s
' "$slug"
}

project_hash() {
  local root
  root="$(project_root)"
  printf '%s' "$root" | git hash-object --stdin | cut -c1-6
}

team_session() {
  if [ -n "${MADW_SESSION:-}" ]; then
    printf '%s
' "$MADW_SESSION"
  else
    printf 'madw-%s-%s
' "$(project_slug)" "$(project_hash)"
  fi
}

role_session() {
  local role="$1" base
  base="$(team_session)"
  case "$role" in
    leader) printf '%s\n' "$base" ;;
    impl|review) printf '%s-%s\n' "$base" "$role" ;;
    *) die "unknown role: $role" ;;
  esac
}

session_exists() {
  local session="$1" tmux_output
  if tmux_output="$(tmux list-sessions -F '#S' 2>&1)"; then
    printf '%s\n' "$tmux_output" | grep -Fqx "$session"
    return
  fi
  case "$tmux_output" in
    *"Operation not permitted"*|*"Permission denied"*)
      die "tmux socket access denied by this sandbox. Retry only this madw command with elevated permission; an existing restrictive Codex team can migrate with MADW_CODEX_NETWORK_ACCESS=1 and role restarts (also enables outbound network access)."
      ;;
    *"no server running on "*|*"error connecting to "*" (No such file or directory)"*|"no sessions") return 1 ;;
    *) die "cannot inspect tmux sessions: $tmux_output" ;;
  esac
}

pane_exists() {
  local pane="$1"
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fqx "$pane"
}

session_option() {
  local session="$1" option="$2"
  tmux show-options -v -t "$session" "$option" 2>/dev/null || true
}

pane_for_role() {
  local role="$1" session option pane
  session="$(team_session)"
  case "$role" in
    leader) option="@madw_pane_leader" ;;
    impl) option="@madw_pane_impl" ;;
    review) option="@madw_pane_review" ;;
    *) die "unknown role: $role" ;;
  esac
  pane="$(session_option "$session" "$option")"
  [ -n "$pane" ] || die "team metadata is missing $option; run 'madw stop' then 'madw start'"
  pane_exists "$pane" || die "$role pane is missing: $pane"
  printf '%s
' "$pane"
}

role_log_path() {
  local role="$1" root
  case "$role" in leader|impl|review) ;; *) die "unknown role: $role" ;; esac
  root="$(project_root)"
  printf '%s/.agent-team/runtime/logs/%s.log\n' "$root" "$role"
}

configure_role_logging() {
  local role="$1" pane="$2" log_dir log_file quoted_log debug
  debug="$(session_option "$(team_session)" @madw_debug)"
  if [ "${debug:-1}" != 1 ]; then
    tmux pipe-pane -t "$pane"
    return
  fi
  log_file="$(role_log_path "$role")"
  log_dir="$(dirname "$log_file")"
  (umask 077; mkdir -p "$log_dir")
  chmod 700 "$log_dir"
  (umask 077; touch "$log_file")
  chmod 600 "$log_file"
  printf -v quoted_log '%q' "$log_file"
  # Replacing the pipe keeps logging attached after a pane's shell or Agent
  # process has been respawned, and prevents stale pipe processes.
  tmux pipe-pane -t "$pane" "cat >> $quoted_log"
}

configure_team_logging() {
  local role pane
  for role in leader impl review; do
    pane="$(pane_for_role "$role")"
    configure_role_logging "$role" "$pane"
  done
}

set_debug_mode() {
  local mode="$1" session
  case "$mode" in on|off) ;; *) die "debug mode must be on or off" ;; esac
  session="$(team_session)"
  session_exists "$session" || die "team is not running: $session"
  validate_existing_team "$session"
  case "$mode" in
    on) tmux set-option -t "$session" @madw_debug 1 ;;
    off) tmux set-option -t "$session" @madw_debug 0 ;;
  esac
  configure_team_logging
  echo "Debug logging: $mode"
}

resolve_runtime() {
  local requested="${1:-}"
  if [ -z "$requested" ] && [ -n "${MADW_RUNTIME:-}" ]; then
    requested="$MADW_RUNTIME"
  fi
  if [ -n "$requested" ] && [ "$requested" != "auto" ]; then
    case "$requested" in
      pi|codex) printf '%s
' "$requested"; return ;;
      *) die "unsupported runtime: $requested (expected pi or codex)" ;;
    esac
  fi
  if [ -n "${MADW_AGENT_CMD:-}" ]; then
    printf '%s
' "custom"
  elif command -v pi >/dev/null 2>&1; then
    printf '%s
' "pi"
  elif command -v codex >/dev/null 2>&1; then
    printf '%s
' "codex"
  else
    die "no supported Agent runtime found; install pi/codex or set MADW_AGENT_CMD"
  fi
}

runtime_command() {
  local runtime="$1"
  if [ -n "${MADW_AGENT_CMD:-}" ]; then
    printf '%s
' "$MADW_AGENT_CMD"
    return
  fi
  case "$runtime" in
    pi) printf '%s
' "pi" ;;
    codex)
      case "${MADW_CODEX_NETWORK_ACCESS-1}" in
        1) printf '%s\n' "codex -s workspace-write -c 'sandbox_workspace_write.network_access=true'" ;;
        0) printf '%s\n' "codex -s workspace-write -c 'sandbox_workspace_write.network_access=false'" ;;
        *) die "MADW_CODEX_NETWORK_ACCESS must be 0 or 1" ;;
      esac
      ;;
    custom) die "MADW_AGENT_CMD is required for custom runtime" ;;
    *) die "unsupported runtime: $runtime" ;;
  esac
}

pane_command() {
  local root="$1" cmd="$2" agent_path="${3:-$PATH}" quoted_root quoted_cli quoted_path
  printf -v quoted_root '%q' "$root"
  printf -v quoted_cli '%q' "$SCRIPT_DIR/madw"
  printf -v quoted_path '%q' "$agent_path"
  printf 'cd -- %s && export MADW_CLI=%s PATH=%s && exec %s\n' "$quoted_root" "$quoted_cli" "$quoted_path" "$cmd"
}

manual_shell_command() {
  local root="$1" shell quoted_root quoted_shell
  shell="$(tmux show-options -gv default-shell 2>/dev/null || true)"
  [ -n "$shell" ] || shell="${SHELL:-/bin/sh}"
  printf -v quoted_root '%q' "$root"
  printf -v quoted_shell '%q' "$shell"
  # tmux -c can retain the server's old cwd after that directory is replaced.
  # Enter the project explicitly before starting the interactive role shell.
  printf 'cd -- %s && export MADW_PROJECT_ROOT=%s && exec %s -l\n' \
    "$quoted_root" "$quoted_root" "$quoted_shell"
}

command_head() {
  local cmd="$1"
  set -- $cmd
  [ "$#" -gt 0 ] || die "empty Agent command"
  printf '%s
' "$1"
}

preflight_base() {
  require_command git
  require_command tmux
  local tmux_error
  if ! tmux_error="$(tmux list-sessions -F '#S' 2>&1)"; then
    case "$tmux_error" in
      *"Operation not permitted"*|*"Permission denied"*)
        die "tmux socket access denied by this sandbox. Retry only this madw command with elevated permission; an existing restrictive Codex team can migrate with MADW_CODEX_NETWORK_ACCESS=1 and role restarts (also enables outbound network access)."
        ;;
      *"no server running on "*|*"error connecting to "*" (No such file or directory)"*|"no sessions") ;;
      *) die "cannot inspect tmux sessions: $tmux_error" ;;
    esac
  fi
  project_root >/dev/null
  [ -f "$SKILL_ROOT/SKILL.md" ] ||
    die "Skill installation is incomplete: $SKILL_ROOT/SKILL.md not found"
}

preflight_runtime() {
  local runtime="$1" cmd head
  cmd="$(runtime_command "$runtime")"
  head="$(command_head "$cmd")"
  command -v "$head" >/dev/null 2>&1 ||
    die "Agent command not found: $head"
}

prepare_control_plane() {
  local root exclude cli_link
  root="$(project_root)"
  if [ -n "$(git -C "$root" ls-files -- .agent-team)" ]; then
    die ".agent-team is tracked by Git; move it out of the Code Plane before starting the team"
  fi
  if ! git -C "$root" check-ignore -q .agent-team/; then
    exclude="$(git -C "$root" rev-parse --git-path info/exclude)"
    mkdir -p "$(dirname "$exclude")"
    printf '\n.agent-team/\n' >> "$exclude"
  fi
  mkdir -p "$root/.agent-team/tasks"
  cli_link="$root/.agent-team/madw"
  if [ -e "$cli_link" ] && [ ! -L "$cli_link" ]; then
    die "cannot install project CLI link; path already exists: $cli_link"
  fi
  ln -sfn "$SCRIPT_DIR/madw" "$cli_link"
}

validate_existing_team() {
  local session="$1" root stored
  root="$(project_root)"
  stored="$(session_option "$session" "@madw_project_root")"
  [ -n "$stored" ] || die "tmux session '$session' exists but is not a MADW team"
  [ "$stored" = "$root" ] || die "tmux session '$session' belongs to another project: $stored"
  pane_for_role leader >/dev/null
  pane_for_role impl >/dev/null
  pane_for_role review >/dev/null
}

pane_is_alive() {
  local pane="$1" dead
  # A sandbox may deny kill -0 against the Agent even while tmux can see it.
  # Only tmux's explicit dead state authorizes automatic pane replacement.
  dead="$(tmux display-message -p -t "$pane" '#{pane_dead}')" ||
    die "cannot inspect pane health: $pane"
  case "$dead" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "unknown pane health for $pane: $dead" ;;
  esac
}

wait_pane_alive() {
  local pane="$1" timeout="${2:-$DEFAULT_BOOT_TIMEOUT}"
  local started now
  started="$(date +%s)"
  while :; do
    pane_exists "$pane" || die "pane disappeared during startup: $pane"
    if pane_is_alive "$pane"; then
      return 0
    fi
    now="$(date +%s)"
    if [ $((now - started)) -ge "$timeout" ]; then
      echo "madw: Agent process did not remain alive in pane $pane within ${timeout}s" >&2
      tmux capture-pane -p -t "$pane" -S -40 >&2 2>/dev/null || true
      return 1
    fi
    sleep 0.1
  done
}

wait_pane_ready() {
  local pane="$1" timeout="${2:-$DEFAULT_BOOT_TIMEOUT}" runtime="$3"
  local started now alt tui_ready
  wait_pane_alive "$pane" "$timeout" || return 1
  case "$runtime" in
    pi|codex|manual) ;;
    *)
      tui_ready="$(session_option "$(team_session)" @madw_tui_ready)"
      [ "${tui_ready:-${MADW_TUI_READY:-0}}" = "1" ] || return 0 ;;
  esac
  # Process liveness is not input readiness: after respawn, interactive Agents
  # spend a while initializing and redraw a full-screen UI that silently
  # discards input pasted before it is ready (observed with Pi: the paste is
  # echoed by the pre-UI terminal and then erased on redraw). Both supported
  # runtimes enter the terminal alternate screen exactly when their UI becomes
  # ready to receive a handoff, so gate delivery on that.
  started="$(date +%s)"
  while :; do
    if ! pane_is_alive "$pane"; then
      echo "madw: Agent exited before its UI became ready in pane $pane" >&2
      tmux capture-pane -p -t "$pane" -S -40 >&2 2>/dev/null || true
      return 1
    fi
    alt="$(tmux display-message -p -t "$pane" '#{alternate_on}' 2>/dev/null || true)"
    if [ "$alt" = "1" ]; then
      return 0
    fi
    now="$(date +%s)"
    if [ $((now - started)) -ge "$DEFAULT_TUI_READY_TIMEOUT" ]; then
      echo "madw: Agent UI in pane $pane did not become ready within ${DEFAULT_TUI_READY_TIMEOUT}s; handoff was not sent" >&2
      tmux capture-pane -p -t "$pane" -S -40 >&2 2>/dev/null || true
      return 1
    fi
    sleep 0.1
  done
}

send_to_pane() {
  local pane="$1" message="$2"
  local buffer="madw-$PPID-$$-$(date +%s)"
  printf '%s' "$message" | tmux load-buffer -b "$buffer" -
  tmux paste-buffer -b "$buffer" -t "$pane" -d
  # Interactive TUIs process bracketed paste asynchronously; an immediate
  # Enter may arrive before the pasted text and leave it in the input box.
  sleep 0.3
  tmux send-keys -t "$pane" Enter
}

role_prompt() {
  local role="$1" root
  root="$(project_root)"
  case "$role" in
    leader)
      cat <<EOF
请使用 multi-agent-development-workflow Skill，并按其中的 Lead 角色工作。
项目：$root

【先向用户说明】
请先只回复下面三行，不调用工具，也不创建任务：
队长，Lead 已就绪。
请确认 Impl 和 Review Agent 已启动，再在 Lead 会话输入开发需求。
我会按需分派任务，并在完成后向你汇报。

【收到开发需求后】
1. 你是唯一与用户交流、管理任务状态和最终验收的 Lead。
2. 控制面固定在项目的 .agent-team/；启动器已确认它不进入 Git 代码快照。
3. 将计划、实现和返工交给 Impl；将独立验证交给 Review。
4. 使用 ./.agent-team/madw send / wait 交接并等待完成。
5. 每轮正式评审前，先运行 ./.agent-team/madw restart review。
6. 以 STATUS 和不可变工件为准，完成实现、评审、返工和验收闭环。
7. 若通过 madw 启动 Codex，它默认使用 workspace-write 并允许网络，以连接 tmux；MADW_CODEX_NETWORK_ACCESS=0 可选择限制模式。
8. 任何 tmux/madw 会话查询失败都只表示状态未知，绝不能解释为“没有团队”，也不要启动或重建 session；保留原错误并对失败命令重试或申请提升权限。
9. 用户尚未提出需求时，保持待命。
EOF
      ;;
    impl)
      cat <<EOF
请使用 multi-agent-development-workflow Skill，并按其中的 Impl 角色工作。
项目：$root

【收到 Lead 交接后】
1. 先读取指定任务的 STATUS，再执行下方交接的计划、实现或返工工作。
2. 只修改该角色允许的内容，写入本轮不可变工件。
3. 完成后运行 ./.agent-team/madw signal impl <TASK-ID> <ROUND>。
4. 不修改 STATUS，不自行派发 Review。
5. 若通过 madw 启动 Codex，它默认使用 workspace-write 并允许网络，以连接 tmux；MADW_CODEX_NETWORK_ACCESS=0 可选择限制模式。
6. 若 madw 仍报 tmux socket access denied，只对该条命令申请提升权限并重试。
EOF
      ;;
    review)
      cat <<EOF
请使用 multi-agent-development-workflow Skill，并按其中的 Review 角色工作。
项目：$root

【收到 Lead 交接后】
1. 先读取指定任务的 STATUS，独立核验冻结且干净的 Code Head。
2. 只写入一份本轮 REVIEW 工件，不修改实现代码和 STATUS。
3. 完成后运行 ./.agent-team/madw signal review <TASK-ID> <ROUND>。
4. 若通过 madw 启动 Codex，它默认使用 workspace-write 并允许网络，以连接 tmux；MADW_CODEX_NETWORK_ACCESS=0 可选择限制模式。
5. 若 madw 仍报 tmux socket access denied，只对该条命令申请提升权限并重试。
EOF
      ;;
  esac
}

bootstrap_team() {
  local lead="$1"
  send_to_pane "$lead" "$(role_prompt leader)"
}

configure_team_labels() {
  local session lead impl review
  session="$(team_session)"
  lead="$(pane_for_role leader)"
  impl="$(pane_for_role impl)"
  review="$(pane_for_role review)"
  tmux set-window-option -t "$session:team" pane-border-status bottom
  tmux set-window-option -t "$session:team" pane-border-format ' #[fg=colour51,bold]#{?#{==:#{@madw_role},leader},[Lead],}#[fg=colour82,bold]#{?#{==:#{@madw_role},impl},[Impl],}#[fg=colour213,bold]#{?#{==:#{@madw_role},review},[Review],}#[default] '
  tmux set-option -p -t "$lead" @madw_label "Lead"
  tmux set-option -p -t "$impl" @madw_label "Impl"
  tmux set-option -p -t "$review" @madw_label "Review"
}

configure_team_progress() {
  local session context_command progress_command communication_command
  session="$(team_session)"
  printf -v context_command '%q statusline context %q' "$SCRIPT_DIR/madw" "$session"
  printf -v progress_command '%q statusline progress %q' "$SCRIPT_DIR/madw" "$session"
  printf -v communication_command '%q statusline communication %q' "$SCRIPT_DIR/madw" "$session"
  tmux set-option -t "$session" status 5
  tmux set-option -t "$session" status-interval 5
  tmux set-option -t "$session" 'status-format[1]' "#[bg=colour235,fill=colour235,fg=colour39,bold]  ◈ 工作目录与分支  #[fg=colour252,nobold]#($context_command)"
  tmux set-option -t "$session" 'status-format[2]' "#[bg=colour235,fill=colour235,fg=colour51,bold]  ◆ 任务进度   #[fg=colour252,nobold]#($progress_command)"
  tmux set-option -t "$session" 'status-format[3]' '#[bg=colour235,fill=colour235] '
  tmux set-option -t "$session" 'status-format[4]' "#[bg=colour235,fill=colour235,fg=colour215,bold]  ↔ Agent 通信  #[fg=colour252,nobold]#($communication_command)"
  if [ -z "$(session_option "$session" @madw_task_display)" ]; then
    tmux set-option -t "$session" @madw_task_display '尚未记录当前任务'
  fi
  if [ -z "$(session_option "$session" @madw_flow_display)" ]; then
    tmux set-option -t "$session" @madw_flow_display '等待用户输入需求或 Leader 发起交接'
  fi
}

state_label() {
  case "$1" in
    CREATED) echo '待规划' ;;
    PLANNING) echo '规划中' ;;
    PLAN_REVIEW) echo '计划待确认' ;;
    PLAN_REWORK) echo '计划返工' ;;
    READY_FOR_IMPLEMENTATION) echo '待实现' ;;
    IMPLEMENTING) echo '实现中' ;;
    READY_FOR_REVIEW) echo '待评审' ;;
    REVIEWING) echo '评审中' ;;
    REWORK) echo '实现返工' ;;
    READY_FOR_FINAL_ACCEPTANCE) echo '待最终验收' ;;
    ACCEPTED) echo '已验收' ;;
    CANCELLED) echo '已取消' ;;
    BLOCKED) echo '已阻塞' ;;
    *) echo "${1:-状态未知}" ;;
  esac
}

statusline() {
  local part="$1" session="$2" root branch task_id status state flow
  root="$(session_option "$session" @madw_project_root)"
  [ -n "$root" ] || return 0

  case "$part" in
    context)
      branch="$(git -C "$root" branch --show-current 2>/dev/null || true)"
      if [ -z "$branch" ]; then
        branch="HEAD $(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)"
      fi
      printf '分支 %s  ·  目录 %s\n' "$branch" "$root"
      ;;
    progress)
      task_id="$(session_option "$session" @madw_flow_task)"
      status="$root/.agent-team/tasks/$task_id/STATUS.md"
      state='等待状态文件'
      [ -z "$task_id" ] || [ ! -f "$status" ] || state="$(status_state "$status")"
      if [ -n "$task_id" ]; then
        printf '【%s】 %s\n' "$(state_label "$state")" "$task_id"
      else
        printf '尚未记录当前任务\n'
      fi
      ;;
    communication)
      task_id="$(session_option "$session" @madw_flow_task)"
      status="$root/.agent-team/tasks/$task_id/STATUS.md"
      state=''
      if [ -n "$task_id" ] && [ -f "$status" ]; then
        state="$(status_state "$status")"
      fi
      flow="$(session_option "$session" @madw_flow_display)"
      case "$state" in
        ACCEPTED) flow='Leader → 用户  |  任务已验收，等待新需求' ;;
        CANCELLED) flow='Leader → 用户  |  任务已取消' ;;
        BLOCKED) flow='Leader → 用户  |  任务已阻塞，等待处理' ;;
      esac
      [ -n "$flow" ] && printf '%s\n' "$flow"
      ;;
    *) return 2 ;;
  esac
}

set_team_progress() {
  local task_id="$1" flow="$2" session status state
  session="$(team_session)"
  configure_team_progress
  if [ -n "$task_id" ]; then
    status="$(project_root)/.agent-team/tasks/$task_id/STATUS.md"
    state='等待 STATUS'
    [ ! -f "$status" ] || state="$(status_state "$status")"
    tmux set-option -t "$session" @madw_flow_task "$task_id"
    tmux set-option -t "$session" @madw_task_display "【$(state_label "$state")】 $task_id"
  fi
  tmux set-option -t "$session" @madw_flow_display "$flow"
}

configure_team_keys() (
  local session table bindings root stop_cmd quoted_root quoted_session quoted_cli quoted_path role
  session="$(team_session)"
  root="$(project_root)"
  table="madw-$(printf '%s' "$session" | git hash-object --stdin | cut -c1-12)"
  bindings="$(mktemp)"
  trap 'rm -f "$bindings"' EXIT

  # Keep the user's root-table mouse and other shortcuts in this team only.
  # A team-specific table closes all its roles without changing unrelated sessions.
  tmux list-keys -T root | sed "s/ -T root / -T $table /" > "$bindings"
  tmux source-file "$bindings"
  printf -v quoted_root '%q' "$root"
  printf -v quoted_session '%q' "$session"
  printf -v quoted_cli '%q' "$SCRIPT_DIR/madw"
  printf -v quoted_path '%q' "$PATH"
  stop_cmd="PATH=$quoted_path MADW_PROJECT_ROOT=$quoted_root MADW_SESSION=$quoted_session $quoted_cli stop"
  tmux bind-key -T "$table" C-c run-shell "$stop_cmd"
  tmux set-option -t "$session" key-table "$table"
  tmux set-option -t "$session" detach-on-destroy on
  if [ "$(session_option "$session" @madw_runtime)" = manual ] &&
     [ "$(session_option "$session" @madw_topology)" != panes ]; then
    for role in impl review; do
      if session_exists "$(role_session "$role")"; then
        tmux set-option -t "$(role_session "$role")" key-table "$table"
        tmux set-option -t "$(role_session "$role")" detach-on-destroy on
      fi
    done
  fi
)

create_team() {
  local runtime="$1" boot_timeout="$2" layout="$3"
  local root session cmd pane_cmd lead impl review
  root="$(project_root)"
  session="$(team_session)"
  cmd="$(runtime_command "$runtime")"
  pane_cmd="$(pane_command "$root" "$cmd")"

  tmux new-session -d -s "$session" -n team -c "$root" "$pane_cmd"
  tmux set-option -t "$session" mouse on
  tmux set-option -t "$session:team" remain-on-exit on
  lead="$(tmux display-message -p -t "$session:team.0" '#{pane_id}')"
  impl="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$lead" -c "$root" "$pane_cmd")"
  review="$(tmux split-window -v -l 50% -P -F '#{pane_id}' -t "$impl" -c "$root" "$pane_cmd")"
  if [ "$layout" = "columns" ]; then
    tmux select-layout -t "$session:team" even-horizontal
  fi

  tmux select-pane -t "$lead" -T "Lead"
  tmux select-pane -t "$impl" -T "Impl"
  tmux select-pane -t "$review" -T "Review"
  tmux select-pane -t "$lead"

  tmux set-option -t "$session" @madw_project_root "$root"
  tmux set-option -t "$session" @madw_runtime "$runtime"
  tmux set-option -t "$session" @madw_debug 1
  tmux set-option -t "$session" @madw_tui_ready "${MADW_TUI_READY:-0}"
  tmux set-option -t "$session" @madw_layout "$layout"
  tmux set-option -t "$session" @madw_agent_cmd "$cmd"
  tmux set-option -t "$session" @madw_agent_path "$PATH"
  tmux set-option -t "$session" @madw_skill_root "$SKILL_ROOT"
  tmux set-option -t "$session" @madw_pane_leader "$lead"
  tmux set-option -t "$session" @madw_pane_impl "$impl"
  tmux set-option -t "$session" @madw_pane_review "$review"
  tmux set-option -p -t "$lead" @madw_role leader
  tmux set-option -p -t "$impl" @madw_role impl
  tmux set-option -p -t "$review" @madw_role review
  configure_team_logging
  configure_team_labels
  configure_team_progress
  configure_team_keys

  if ! wait_pane_ready "$lead" "$boot_timeout" "$runtime" ||
     ! wait_pane_ready "$impl" "$boot_timeout" "$runtime" ||
     ! wait_pane_ready "$review" "$boot_timeout" "$runtime"; then
    tmux kill-session -t "$session" 2>/dev/null || true
    die "team startup failed; partial tmux session removed"
  fi

  bootstrap_team "$lead"
  printf 'Project: %s
' "$root"
  printf 'Team:    %s
' "$session"
  printf 'Runtime: %s
' "$runtime"
}

create_manual_sessions() {
  local root session lead impl review role shell_cmd
  root="$(project_root)"
  session="$(team_session)"
  shell_cmd="$(manual_shell_command "$root")"
  for role in impl review; do
    ! session_exists "$(role_session "$role")" ||
      die "session already exists: $(role_session "$role")"
  done
  tmux new-session -d -s "$session" -n lead -c "$root" "$shell_cmd"
  if ! tmux new-session -d -s "$(role_session impl)" -n impl -c "$root" "$shell_cmd" ||
     ! tmux new-session -d -s "$(role_session review)" -n review -c "$root" "$shell_cmd"; then
    tmux kill-session -t "$(role_session review)" 2>/dev/null || true
    tmux kill-session -t "$(role_session impl)" 2>/dev/null || true
    tmux kill-session -t "$session" 2>/dev/null || true
    die "manual team startup failed"
  fi
  lead="$(tmux display-message -p -t "$session:lead.0" '#{pane_id}')"
  impl="$(tmux display-message -p -t "$(role_session impl):impl.0" '#{pane_id}')"
  review="$(tmux display-message -p -t "$(role_session review):review.0" '#{pane_id}')"
  tmux set-option -t "$session" @madw_project_root "$root"
  tmux set-option -t "$session" @madw_runtime manual
  tmux set-option -t "$session" @madw_topology sessions
  tmux set-option -t "$session" @madw_debug 1
  tmux set-option -t "$session" @madw_pane_leader "$lead"
  tmux set-option -t "$session" @madw_pane_impl "$impl"
  tmux set-option -t "$session" @madw_pane_review "$review"
  for role in impl review; do
    tmux set-option -t "$(role_session "$role")" @madw_project_root "$root"
    tmux set-option -t "$(role_session "$role")" @madw_runtime manual
    tmux set-option -t "$(role_session "$role")" status-left " $role | run madw launch pi|codex "
  done
  configure_team_logging
  configure_team_progress
  tmux set-option -t "$session" 'status-format[0]' '#[fg=colour51,bold] Lead | run madw launch pi|codex'
  printf 'Project: %s\n' "$root"
  printf 'Sessions: %s  %s  %s\n' "$session" "$(role_session impl)" "$(role_session review)"
  printf 'In each session, run madw launch pi|codex; you may mix them.\n'
  printf 'Direct pi/codex startup also works; then run madw bootstrap leader.\n'
}

create_manual_team() {
  local layout="$1" root session shell_cmd lead impl review role
  root="$(project_root)"
  session="$(team_session)"
  shell_cmd="$(manual_shell_command "$root")"
  for role in impl review; do
    ! session_exists "$(role_session "$role")" ||
      die "old role session still exists: $(role_session "$role"); stop it before creating a pane team"
  done

  tmux new-session -d -s "$session" -n team -c "$root" "$shell_cmd"
  tmux set-option -t "$session:team" remain-on-exit on
  lead="$(tmux display-message -p -t "$session:team.0" '#{pane_id}')"
  if ! impl="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$lead" -c "$root" "$shell_cmd")"; then
    tmux kill-session -t "$session" 2>/dev/null || true
    die "manual team startup failed"
  fi
  if [ "$layout" = columns ]; then
    if ! review="$(tmux split-window -h -l 50% -P -F '#{pane_id}' -t "$impl" -c "$root" "$shell_cmd")"; then
      tmux kill-session -t "$session" 2>/dev/null || true
      die "manual team startup failed"
    fi
    tmux select-layout -t "$session:team" even-horizontal
  else
    if ! review="$(tmux split-window -v -l 50% -P -F '#{pane_id}' -t "$impl" -c "$root" "$shell_cmd")"; then
      tmux kill-session -t "$session" 2>/dev/null || true
      die "manual team startup failed"
    fi
  fi
  tmux select-pane -t "$lead" -T Lead
  tmux select-pane -t "$impl" -T Impl
  tmux select-pane -t "$review" -T Review
  tmux select-pane -t "$lead"

  tmux set-option -t "$session" @madw_project_root "$root"
  tmux set-option -t "$session" @madw_runtime manual
  tmux set-option -t "$session" @madw_topology panes
  tmux set-option -t "$session" @madw_layout "$layout"
  tmux set-option -t "$session" @madw_debug 1
  tmux set-option -t "$session" @madw_pane_leader "$lead"
  tmux set-option -t "$session" @madw_pane_impl "$impl"
  tmux set-option -t "$session" @madw_pane_review "$review"
  tmux set-option -p -t "$lead" @madw_role leader
  tmux set-option -p -t "$impl" @madw_role impl
  tmux set-option -p -t "$review" @madw_role review
  tmux set-option -t "$session" mouse on
  configure_team_logging
  configure_team_labels
  configure_team_progress
  tmux set-option -t "$session" 'status-format[0]' '#[fg=colour51,bold] Lead | Impl | Review   ·   run madw launch pi|codex in each pane'
  printf 'Project: %s\n' "$root"
  printf 'Team: %s\n' "$session"
  printf 'Layout: %s (Lead / Impl / Review)\n' "$layout"
  printf 'In each role pane, run madw launch pi|codex; you may mix them.\n'
  printf 'Direct pi/codex startup also works; then run madw bootstrap leader.\n'
}

repair_manual_sessions() {
  local root session role pane cmd agent_path pane_cmd shell_cmd
  root="$(project_root)"
  session="$(team_session)"
  shell_cmd="$(manual_shell_command "$root")"
  for role in impl review; do
    if ! session_exists "$(role_session "$role")"; then
      cmd="$(session_option "$session" "@madw_role_cmd_$role")"
      if [ -n "$cmd" ]; then
        agent_path="$(session_option "$session" "@madw_role_path_$role")"
        pane_cmd="$(pane_command "$root" "$cmd" "${agent_path:-$PATH}")"
        tmux new-session -d -s "$(role_session "$role")" -n "$role" -c "$root" "$pane_cmd"
      else
        tmux new-session -d -s "$(role_session "$role")" -n "$role" -c "$root" "$shell_cmd"
      fi
      pane="$(tmux display-message -p -t "$(role_session "$role"):$role.0" '#{pane_id}')"
      tmux set-option -t "$session" "@madw_pane_$role" "$pane"
      tmux set-option -t "$(role_session "$role")" @madw_project_root "$root"
      tmux set-option -t "$(role_session "$role")" @madw_runtime manual
      tmux set-option -t "$(role_session "$role")" status-left " $role | ${cmd:-run madw launch pi|codex} "
      if [ -n "$cmd" ]; then wait_pane_ready "$pane" "$DEFAULT_BOOT_TIMEOUT" manual; fi
    fi
    pane="$(pane_for_role "$role")"
    configure_role_logging "$role" "$pane"
  done
  pane="$(pane_for_role leader)"
  configure_role_logging leader "$pane"
}

attach_team() {
  local focus="${1:-leader}" session pane runtime
  session="$(team_session)"
  session_exists "$session" || die "team is not running: $session"
  validate_existing_team "$session"
  runtime="$(session_option "$session" @madw_runtime)"
  configure_team_keys
  if [ "$runtime" = manual ] && [ "$(session_option "$session" @madw_topology)" != panes ]; then
    session="$(role_session "$focus")"
    session_exists "$session" || die "$focus session is missing: $session"
    if [ -n "${TMUX:-}" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach-session -t "$session"
    fi
    return
  fi
  if [ "$runtime" = manual ]; then
    tmux set-option -t "$session" mouse on
    configure_team_labels
    configure_team_progress
    pane="$(pane_for_role "$focus")"
    tmux select-window -t "$session:team"
    tmux select-pane -t "$pane"
    if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$session"; else tmux attach-session -t "$session"; fi
    return
  fi
  tmux set-option -t "$session" mouse on
  configure_team_labels
  configure_team_progress
  configure_team_keys
  repair_dead_panes
  pane="$(pane_for_role "$focus")"
  tmux select-window -t "$session:team"
  tmux select-pane -t "$pane"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

parse_section_value() {
  local file="$1" section="$2" field="$3"
  awk -v section="$section" -v field="$field" '
    $0 == "## " section {inside=1; next}
    inside && /^## / {exit}
    inside && index($0, field ":") == 1 {
      sub("^" field ":[[:space:]]*", "", $0)
      print
      exit
    }
  ' "$file"
}

status_state() {
  local file="$1"
  awk '
    $0 == "## Current State" {inside=1; next}
    inside && NF {print; exit}
  ' "$file"
}

print_task_summary() {
  local root tasks_dir status_file state count task_id head impl review candidate candidate_state
  root="$(project_root)"
  tasks_dir="$root/.agent-team/tasks"
  count=0
  task_id=""
  state=""
  status_file=""

  if [ -d "$tasks_dir" ]; then
    for candidate in "$tasks_dir"/*/STATUS.md; do
      [ -f "$candidate" ] || continue
      candidate_state="$(status_state "$candidate")"
      case "$candidate_state" in ACCEPTED|CANCELLED) continue ;; esac
      count=$((count + 1))
      if [ "$count" -eq 1 ]; then
        status_file="$candidate"
        task_id="$(basename "$(dirname "$candidate")")"
        state="$candidate_state"
      fi
    done
  fi

  if [ "$count" -eq 0 ]; then
    echo "Task:    no active task"
    return
  fi
  if [ "$count" -gt 1 ]; then
    echo "Task:    $count active tasks (Lead must select explicitly)"
    for candidate in "$tasks_dir"/*/STATUS.md; do
      [ -f "$candidate" ] || continue
      candidate_state="$(status_state "$candidate")"
      case "$candidate_state" in ACCEPTED|CANCELLED) continue ;; esac
      printf '  - %s  %s
' "$(basename "$(dirname "$candidate")")" "$candidate_state"
    done
    return
  fi

  head="$(parse_section_value "$status_file" "Current Implementation" "Code Head SHA")"
  impl="$(parse_section_value "$status_file" "Current Implementation" "Artifact")"
  review="$(parse_section_value "$status_file" "Current Review" "Artifact")"
  printf 'Task:    %s
' "$task_id"
  printf 'State:   %s
' "${state:-UNKNOWN}"
  [ -n "$head" ] && [ "$head" != "N/A" ] && printf 'HEAD:    %s
' "$head"
  [ -n "$impl" ] && [ "$impl" != "N/A" ] && printf 'Impl:    %s
' "$impl"
  [ -n "$review" ] && [ "$review" != "N/A" ] && printf 'Review:  %s
' "$review"
  case "$state" in
    PLANNING|PLAN_REWORK|IMPLEMENTING) echo "Next: Impl, then Lead after new artifact" ;;
    REVIEWING) echo "Next: Review, then Lead after new artifact" ;;
    *) echo "Expected next actor: Lead" ;;
  esac
}

status_team() {
  local root session runtime role pane cmd pid health
  root="$(project_root)"
  session="$(team_session)"
  echo "Project: $root"
  echo "Team:    $session"
  if ! session_exists "$session"; then
    echo "Runtime: N/A"
    echo "Team status: NOT RUNNING"
    print_task_summary
    return 1
  fi

  validate_existing_team "$session"
  runtime="$(session_option "$session" "@madw_runtime")"
  configure_team_progress
  echo "Runtime: $runtime"
  if [ "$runtime" = manual ]; then
    if [ "$(session_option "$session" @madw_topology)" = panes ]; then
      echo "Layout: $(session_option "$session" @madw_layout) (Lead / Impl / Review)"
    else
      echo "Sessions: $session  $(role_session impl)  $(role_session review)"
    fi
  fi
  print_task_summary
  echo
  printf '%-8s %-8s %-18s %-8s %s
' "ROLE" "PANE" "COMMAND" "HEALTH" "PID"
  for role in leader impl review; do
    pane="$(pane_for_role "$role")"
    cmd="$(tmux display-message -p -t "$pane" '#{pane_current_command}')"
    pid="$(tmux display-message -p -t "$pane" '#{pane_pid}')"
    if pane_is_alive "$pane"; then health="alive"; else health="dead"; fi
    printf '%-8s %-8s %-18s %-8s %s
' "$role" "$pane" "$cmd" "$health" "$pid"
  done
}

restart_role() {
  local role="$1"
  local session pane runtime cmd pane_cmd root title agent_path
  session="$(team_session)"
  session_exists "$session" || die "team is not running: $session"
  validate_existing_team "$session"
  pane="$(pane_for_role "$role")"
  root="$(project_root)"
  runtime="$(session_option "$session" "@madw_runtime")"
  if [ "$runtime" = manual ]; then
    cmd="$(session_option "$session" "@madw_role_cmd_$role")"
    if [ -n "$cmd" ]; then
      agent_path="$(session_option "$session" "@madw_role_path_$role")"
      pane_cmd="$(pane_command "$root" "$cmd" "${agent_path:-$PATH}")"
      tmux respawn-pane -k -t "$pane" -c "$root" "$pane_cmd"
      wait_pane_ready "$pane" "$DEFAULT_BOOT_TIMEOUT" manual
      configure_role_logging "$role" "$pane"
      if [ "$role" = leader ]; then send_to_pane "$pane" "$(role_prompt leader)"; fi
      echo "restarted $role using its selected Agent"
    else
      pane_cmd="$(manual_shell_command "$root")"
      tmux respawn-pane -k -t "$pane" -c "$root" "$pane_cmd"
      configure_role_logging "$role" "$pane"
      echo "reset $role shell; start Pi or Codex there, then dispatch its role prompt"
    fi
    return
  fi
  cmd="$(session_option "$session" "@madw_agent_cmd")"

  [ -n "$runtime" ] || die "team metadata is missing runtime"
  [ -n "$cmd" ] || die "team metadata is missing Agent command"

  agent_path="$(session_option "$session" "@madw_agent_path")"
  if [ -z "$agent_path" ]; then
    # Older teams did not record PATH; adopt this caller's path once.
    agent_path="$PATH"
    tmux set-option -t "$session" @madw_agent_path "$agent_path"
  fi
  pane_cmd="$(pane_command "$root" "$cmd" "$agent_path")"
  tmux respawn-pane -k -t "$pane" -c "$root" "$pane_cmd"
  case "$role" in
    leader) title="Lead" ;;
    impl) title="Impl" ;;
    review) title="Review" ;;
    *) die "unknown role: $role" ;;
  esac
  tmux select-pane -t "$pane" -T "$title"
  configure_team_labels
  wait_pane_ready "$pane" "$DEFAULT_BOOT_TIMEOUT" "$runtime"
  configure_role_logging "$role" "$pane"

  if [ "$role" = "leader" ]; then
    send_to_pane "$pane" "$(role_prompt "$role")"
  fi

  echo "restarted $role in $pane using team runtime $runtime"
}

repair_dead_panes() {
  local role pane
  for role in leader impl review; do
    pane="$(pane_for_role "$role")"
    if ! pane_is_alive "$pane"; then
      restart_role "$role"
    fi
  done
}

show_role_logs() {
  local role="$1" lines="${2:-120}" log_file
  case "$role" in leader|impl|review) ;; *) die "logs role must be leader, impl, or review" ;; esac
  [[ "$lines" =~ ^[1-9][0-9]*$ ]] || die "log line count must be a positive integer"
  log_file="$(role_log_path "$role")"
  [ -f "$log_file" ] || die "no log exists for $role yet: $log_file"
  tail -n "$lines" "$log_file" | perl -pe 's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g'
}

stop_team() {
  local session runtime role root
  session="$(team_session)"
  if session_exists "$session"; then
    root="$(project_root)"
    [ "$(session_option "$session" @madw_project_root)" = "$root" ] ||
      die "refusing to stop a session belonging to another project: $session"
    runtime="$(session_option "$session" @madw_runtime)"
    if [ "$runtime" = manual ] && [ "$(session_option "$session" @madw_topology)" != panes ]; then
      for role in impl review; do
        if session_exists "$(role_session "$role")"; then
          [ "$(session_option "$(role_session "$role")" @madw_project_root)" = "$root" ] ||
            die "refusing to stop a role session belonging to another project: $(role_session "$role")"
        fi
      done
      for role in impl review; do
        tmux kill-session -t "$(role_session "$role")" 2>/dev/null || true
      done
    fi
    tmux kill-session -t "$session"
    echo "stopped $session"
  else
    echo "team is not running: $session"
  fi
}

handoff_kind() {
  local role="$1" task_id="$2" root status state
  root="$(project_root)"
  status="$root/.agent-team/tasks/$task_id/STATUS.md"
  [ -f "$status" ] || die "STATUS not found for $task_id"
  state="$(status_state "$status")"
  if [ "$role" = "review" ]; then
    printf '%s\n' "review"
  else
    case "$state" in
      PLANNING|PLAN_REWORK) printf '%s\n' "plan" ;;
      *) printf '%s\n' "impl" ;;
    esac
  fi
}

handoff_channel() {
  local role="$1" task_id="$2" round="$3" kind
  case "$role" in impl|review) ;; *) die "completion role must be impl or review" ;; esac
  case "$round" in [0-9][0-9][0-9]) ;; *) die "ROUND must be three digits, for example 001" ;; esac
  kind="$(handoff_kind "$role" "$task_id")"
  printf 'madw:%s:%s:%s:%s:%s\n' "$(team_session)" "$task_id" "$role" "$kind" "$round"
}

handoff_option() {
  local channel="$1" digest
  digest="$(printf '%s' "$channel" | git hash-object --stdin | cut -c1-20)"
  printf '@madw_done_%s\n' "$digest"
}

verify_handoff() {
  local session="$1" option="$2" artifact="$3" expected actual
  expected="$(session_option "$session" "$option")"
  [ -n "$expected" ] || die "completion signal has no recorded artifact hash: $option"
  [ -f "$artifact" ] || die "completion was signaled but expected artifact is missing: $artifact"
  actual="$(git hash-object -- "$artifact")"
  [ "$actual" = "$expected" ] ||
    die "completion artifact changed after signal: $artifact"
}

expected_artifact() {
  local role="$1" task_id="$2" round="$3" root status state
  root="$(project_root)"
  status="$root/.agent-team/tasks/$task_id/STATUS.md"
  [ -f "$status" ] || die "STATUS not found for $task_id"
  state="$(status_state "$status")"
  if [ "$role" = "review" ]; then
    printf '%s/.agent-team/tasks/%s/reviews/REVIEW-%s.md\n' "$root" "$task_id" "$round"
  else
    case "$state" in
      PLANNING|PLAN_REWORK)
        printf '%s/.agent-team/tasks/%s/plans/PLAN-v%s.md\n' "$root" "$task_id" "$round"
        ;;
      *)
        printf '%s/.agent-team/tasks/%s/implementations/IMPL-%s.md\n' "$root" "$task_id" "$round"
        ;;
    esac
  fi
}

wait_handoff() {
  local role="$1" task_id="$2" round="$3" timeout="${4:-$DEFAULT_WAIT_TIMEOUT}"
  local channel option session pane waiter started now artifact
  channel="$(handoff_channel "$role" "$task_id" "$round")"
  option="$(handoff_option "$channel")"
  session="$(team_session)"
  pane="$(pane_for_role "$role")"
  artifact="$(expected_artifact "$role" "$task_id" "$round")"

  local actor
  case "$role" in impl) actor='Impl' ;; review) actor='Review' ;; esac

  if [ -n "$(session_option "$session" "$option")" ]; then
    verify_handoff "$session" "$option" "$artifact"
    set_team_progress "$task_id" "$actor → Leader  |  第 $round 轮已完成，等待 Leader 检查工件"
    echo "completed: $channel"
    echo "artifact:  $artifact"
    return 0
  fi

  set_team_progress "$task_id" "Leader → $actor  |  等待第 $round 轮工件与完成信号"
  tmux wait-for "$channel" &
  waiter=$!
  started="$(date +%s)"
  while kill -0 "$waiter" 2>/dev/null; do
    if ! pane_exists "$pane"; then
      kill "$waiter" 2>/dev/null || true; wait "$waiter" 2>/dev/null || true
      set_team_progress "$task_id" "⚠ $actor 面板消失  |  等待已中止"
      die "$role pane disappeared while waiting for $channel"
    fi
    if ! pane_is_alive "$pane"; then
      kill "$waiter" 2>/dev/null || true; wait "$waiter" 2>/dev/null || true
      set_team_progress "$task_id" "⚠ $actor 已退出  |  等待已中止"
      echo "madw: $role Agent exited while waiting for $channel" >&2
      tmux capture-pane -p -t "$pane" -S -80 >&2 2>/dev/null || true
      return 2
    fi
    now="$(date +%s)"
    if [ $((now - started)) -ge "$timeout" ]; then
      kill "$waiter" 2>/dev/null || true; wait "$waiter" 2>/dev/null || true
      set_team_progress "$task_id" "⚠ 等待 $actor 超时  |  请检查右侧 Agent"
      echo "madw: timeout waiting ${timeout}s for $channel" >&2
      tmux capture-pane -p -t "$pane" -S -80 >&2 2>/dev/null || true
      return 124
    fi
    sleep 0.25
  done
  wait "$waiter"

  verify_handoff "$session" "$option" "$artifact"
  set_team_progress "$task_id" "$actor → Leader  |  第 $round 轮已完成，等待 Leader 检查工件"
  echo "completed: $channel"
  echo "artifact:  $artifact"
}

signal_handoff() {
  local channel option artifact session digest prior actor active_task
  channel="$(handoff_channel "$1" "$2" "$3")"
  option="$(handoff_option "$channel")"
  artifact="$(expected_artifact "$1" "$2" "$3")"
  session="$(team_session)"
  session_exists "$session" || die "team is not running: $session"
  [ -f "$artifact" ] || die "cannot signal before writing expected artifact: $artifact"
  digest="$(git hash-object -- "$artifact")"
  prior="$(session_option "$session" "$option")"
  if [ -n "$prior" ] && [ "$prior" != "$digest" ]; then
    die "completion was already recorded for a different artifact: $artifact"
  fi
  tmux set-option -t "$session" "$option" "$digest"
  tmux wait-for -S "$channel"
  case "$1" in impl) actor='Impl' ;; review) actor='Review' ;; esac
  active_task="$(session_option "$session" @madw_flow_task)"
  if [ -z "$active_task" ] || [ "$active_task" = "$2" ]; then
    set_team_progress "$2" "$actor → Leader  |  第 $3 轮工件已提交，等待 Lead 验证"
  fi
  echo "signaled: $channel"
}

send_role() {
  local role="$1" message="$2" pane task_id actor session runtime
  pane="$(pane_for_role "$role")"
  pane_is_alive "$pane" || die "$role pane is dead; run 'madw restart $role' before sending a handoff"
  session="$(team_session)"
  runtime="$(session_option "$session" @madw_runtime)"
  wait_pane_ready "$pane" "$DEFAULT_BOOT_TIMEOUT" "$runtime"
  task_id="$(printf '%s\n' "$message" | grep -oE 'TASK-[A-Za-z0-9_-]+' | head -1 || true)"
  if [ "$role" = "impl" ] || [ "$role" = "review" ]; then
    message="$(role_prompt "$role")

【Lead 交接任务】
$message"
  fi
  send_to_pane "$pane" "$message"
  [ -n "$task_id" ] || task_id="$(session_option "$(team_session)" @madw_flow_task)"
  case "$role" in
    impl) actor='Impl' ;;
    review) actor='Review' ;;
    leader) actor='Leader' ;;
  esac
  set_team_progress "$task_id" "Leader → $actor  |  任务已交接，$actor 正在处理"
  echo "sent to $role ($pane)"
}

launch_role_agent() {
  local runtime="$1" session pane role selected="" cmd root
  case "$runtime" in pi|codex) ;; *) die "launch requires pi or codex" ;; esac
  session="$(team_session)"
  session_exists "$session" || die "team is not running: $session"
  [ "$(session_option "$session" @madw_runtime)" = manual ] ||
    die "launch is only for manually managed role sessions"
  [ -n "${TMUX_PANE:-}" ] || die "run launch inside a role session"
  for role in leader impl review; do
    pane="$(pane_for_role "$role")"
    if [ "$pane" = "$TMUX_PANE" ]; then selected="$role"; break; fi
  done
  [ -n "$selected" ] || die "this pane is not a role in the current team"
  cmd="$(MADW_AGENT_CMD= runtime_command "$runtime")"
  MADW_AGENT_CMD= preflight_runtime "$runtime"
  tmux set-option -t "$session" "@madw_role_cmd_$selected" "$cmd"
  tmux set-option -t "$session" "@madw_role_path_$selected" "$PATH"
  if [ "$selected" = leader ]; then
    tmux set-option -t "$session" 'status-format[0]' "#[fg=colour51,bold] Lead | $runtime"
  elif [ "$(session_option "$session" @madw_topology)" != panes ]; then
    tmux set-option -t "$(role_session "$selected")" status-left " $selected | $runtime "
  fi
  if [ "$(session_option "$session" @madw_topology)" = panes ]; then
    tmux select-pane -t "$TMUX_PANE" -T "$selected | $runtime"
  fi
  root="$(project_root)"
  if [ "$selected" = leader ]; then
    # The helper waits for the UI before delivering the Lead role prompt.
    ("$SCRIPT_DIR/madw" bootstrap leader >/dev/null 2>"$root/.agent-team/lead-bootstrap.log" ||
      tmux display-message -t "$pane" 'Lead bootstrap failed; check .agent-team/lead-bootstrap.log') &
  fi
  case "$runtime" in
    pi) pi ;;
    codex)
      if [ "${MADW_CODEX_NETWORK_ACCESS-1}" = 0 ]; then
        codex -s workspace-write -c 'sandbox_workspace_write.network_access=false'
      else
        codex -s workspace-write -c 'sandbox_workspace_write.network_access=true'
      fi
      ;;
  esac
}

doctor() {
  local requested="${1:-}" runtime cmd session
  preflight_base
  if [ -z "$requested" ] && [ -z "${MADW_RUNTIME:-}" ] && [ -z "${MADW_AGENT_CMD:-}" ]; then
    runtime=manual
    cmd='user starts Pi or Codex in each role pane'
  else
    runtime="$(resolve_runtime "$requested")"
    preflight_runtime "$runtime"
    cmd="$(runtime_command "$runtime")"
  fi
  session="$(team_session)"
  echo "Project Root: $(project_root)"
  echo "Skill Root:   $SKILL_ROOT"
  echo "tmux:         $(command -v tmux)"
  echo "Runtime:      $runtime"
  echo "Agent Command:$cmd"
  echo "Team:         $session"
  if session_exists "$session"; then validate_existing_team "$session"; echo "Existing Team: valid"; else echo "Existing Team: none"; fi
}

start_command() {
  local requested="" boot_timeout="$DEFAULT_BOOT_TIMEOUT" layout="${MADW_LAYOUT:-columns}" sessions=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      pi|codex) requested="$1"; shift ;;
      --layout) [ "$#" -ge 2 ] || die "--layout requires balanced or columns"; layout="$2"; shift 2 ;;
      --sessions) sessions=1; shift ;;
      --boot-timeout) [ "$#" -ge 2 ] || die "--boot-timeout requires seconds"; boot_timeout="$2"; shift 2 ;;
      *) die "unknown start argument: $1" ;;
    esac
  done
  case "$layout" in balanced|columns) ;; *) die "unknown layout '$layout' (choose balanced or columns)" ;; esac
  if [ "$sessions" = 1 ] && { [ -n "$requested" ] || [ -n "${MADW_RUNTIME:-}" ] || [ -n "${MADW_AGENT_CMD:-}" ]; }; then
    die "--sessions is for manual mode only"
  fi

  preflight_base
  local session root stored_runtime stored_cmd runtime cmd
  session="$(team_session)"
  root="$(project_root)"
  git -C "$root" rev-parse --verify HEAD >/dev/null 2>&1 ||
    die "Git repository has no commit yet. Create an initial commit before 'madw start' so the Task Baseline SHA can be frozen."
  prepare_control_plane

  if session_exists "$session"; then
    stored_runtime="$(session_option "$session" "@madw_runtime")"
    if [ "$sessions" = 1 ] && [ "$(session_option "$session" @madw_topology)" = panes ]; then
      die "team already uses role panes; stop the team before switching to --sessions"
    fi
    if [ "$stored_runtime" = manual ] && [ "$(session_option "$session" @madw_topology)" != panes ]; then repair_manual_sessions; fi
    validate_existing_team "$session"
    if [ -n "$requested" ]; then
      [ "$stored_runtime" = "$requested" ] ||
        die "team already runs runtime '$stored_runtime'; stop the team before changing runtime"
    fi
    if [ "${MADW_CODEX_NETWORK_ACCESS+x}" = "x" ] &&
       [ -z "${MADW_AGENT_CMD:-}" ]; then
      [ "$stored_runtime" = "codex" ] ||
        die "MADW_CODEX_NETWORK_ACCESS can update only an existing Codex team"
      stored_cmd="$(session_option "$session" "@madw_agent_cmd")"
      case "$stored_cmd" in
        "codex"|"codex -s workspace-write -c 'sandbox_workspace_write.network_access=true'"|"codex -s workspace-write -c 'sandbox_workspace_write.network_access=false'") ;;
        *) die "stored Codex Agent command is custom; refusing to replace it with MADW_CODEX_NETWORK_ACCESS" ;;
      esac
      cmd="$(runtime_command codex)"
      tmux set-option -t "$session" @madw_agent_cmd "$cmd"
      echo "Codex network policy saved for future role restarts; running Agents were not interrupted."
    fi
    if [ "$stored_runtime" != manual ]; then
      tmux set-option -t "$session" mouse on
      configure_team_labels
      configure_team_keys
    fi
    configure_team_progress
    repair_dead_panes
    echo "Project: $root"
    echo "Team:    $session"
    echo "Team status: existing"
  else
    if [ -z "$requested" ] && [ -z "${MADW_RUNTIME:-}" ] && [ -z "${MADW_AGENT_CMD:-}" ]; then
      if [ "$sessions" = 1 ]; then create_manual_sessions; else create_manual_team "$layout"; fi
    else
      runtime="$(resolve_runtime "$requested")"
      preflight_runtime "$runtime"
      create_team "$runtime" "$boot_timeout" "$layout"
    fi
  fi

  configure_team_logging
  configure_team_keys
  if [ "${MADW_NO_ATTACH:-0}" != "1" ]; then attach_team leader; fi
}

command="${1:-start}"
[ "$#" -gt 0 ] && shift || true

case "$command" in
  start) start_command "$@" ;;
  launch)
    preflight_base
    [ "$#" -eq 1 ] || die "launch requires pi or codex"
    launch_role_agent "$1"
    ;;
  bootstrap)
    preflight_base
    [ "$#" -eq 1 ] && [ "$1" = leader ] || die "bootstrap supports only leader"
    [ "$(session_option "$(team_session)" @madw_runtime)" = manual ] || die "bootstrap is only needed for manual teams"
    pane="$(pane_for_role leader)"
    wait_pane_ready "$pane" "$DEFAULT_BOOT_TIMEOUT" "$(session_option "$(team_session)" @madw_runtime)"
    send_to_pane "$pane" "$(role_prompt leader)"
    echo "Lead role prompt sent"
    ;;
  status) preflight_base; status_team ;;
  logs)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { usage >&2; exit 2; }
    show_role_logs "$1" "${2:-120}"
    ;;
  debug)
    preflight_base
    [ "$#" -eq 1 ] || die "debug requires on or off"
    set_debug_mode "$1"
    ;;
  statusline) statusline "$@" ;;
  watch) preflight_base; attach_team leader ;;
  attach) preflight_base; attach_team "${1:-leader}" ;;
  send)
    preflight_base
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    role="$1"; shift
    send_role "$role" "$*"
    ;;
  wait)
    preflight_base
    [ "$#" -ge 3 ] || { usage >&2; exit 2; }
    wait_handoff "$1" "$2" "$3" "${4:-$DEFAULT_WAIT_TIMEOUT}"
    ;;
  signal)
    preflight_base
    [ "$#" -eq 3 ] || { usage >&2; exit 2; }
    signal_handoff "$1" "$2" "$3"
    ;;
  restart)
    preflight_base
    [ "$#" -eq 1 ] || {
      echo "madw: restart takes exactly one role; change team runtime with 'madw stop' then 'madw start <runtime>'" >&2
      usage >&2
      exit 2
    }
    restart_role "$1"
    ;;
  stop) preflight_base; stop_team ;;
  doctor) doctor "${1:-}" ;;
  id) require_command git; project_root >/dev/null; printf '%s
' "$(team_session)" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
